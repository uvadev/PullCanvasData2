<Project Sdk="Microsoft.NET.Sdk">
  <!-- Installs the freshly packed library like a .NET Framework consumer would. Run by CI before publishing. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PullCanvasData2" Version="$(PullCanvasData2Version)" />
  </ItemGroup>
</Project>
